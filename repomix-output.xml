import { NextRequest, NextResponse } from "next/server";
import { isValidSessionToken, SESSION_COOKIE } from "@/lib/session";

const publicPath = /^\/estado\/[a-f0-9]{32}$/;

export async function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl;

  if (
    pathname === "/login" ||
    publicPath.test(pathname) ||
    pathname === "/api/logo" ||
    pathname === "/robots.txt" ||
    pathname.startsWith("/_next/") ||
    pathname === "/manifest.webmanifest" ||
    pathname === "/sw.js" ||
    pathname === "/push-sw.js" ||
    pathname === "/api/push/public-key" ||
    pathname === "/api/push/subscribe" ||
    pathname === "/api/push/unsubscribe" ||
    pathname.startsWith("/icons/")
  ) {
    return NextResponse.next();
  }

  if (await isValidSessionToken(request.cookies.get(SESSION_COOKIE)?.value)) {
    return NextResponse.next();
  }

  const loginUrl = new URL("/login", request.url);
  loginUrl.searchParams.set("next", pathname);
  return NextResponse.redirect(loginUrl);
}

export const config = {
  matcher: ["/((?!api/health).*)"]
};
