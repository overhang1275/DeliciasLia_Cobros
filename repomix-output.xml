    ? logs
        .map((log) => `[${fecha.format(log.creadoEn)}] ${log.usuario || "Sistema"} - ${acciones[log.accion] || log.accion} ${log.entidad}${log.entidadId ? ` ID ${log.entidadId}` : ""}${log.detalle ? ` - ${log.detalle}` : ""}`)
